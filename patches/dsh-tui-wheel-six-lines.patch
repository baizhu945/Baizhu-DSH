--- /dev/null
+++ b/scripts/verify-wheel-notch.mjs
@@ -0,0 +1,50 @@
+/** Exercise six-line/coalesced wheel routing through the real Ink App parser. */
+import assert from 'node:assert/strict'
+import App from '../lib/types/ink/components/App.js'
+import { createSelectionState } from '../lib/types/ink/selection.js'
+
+const originalNow = Object.getOwnPropertyDescriptor(performance, 'now')
+let now = 1000
+Object.defineProperty(performance, 'now', { configurable: true, value: () => now })
+const routed = []
+let consume = true
+let fallback = 0
+const noop = () => {}
+const app = new App({
+  children: null, stdin: process.stdin, stdout: process.stdout, stderr: process.stderr,
+  exitOnCtrlC: false, onExit: noop, terminalColumns: 80, terminalRows: 24,
+  selection: createSelectionState(), onSelectionChange: noop,
+  onClickAt: () => false, onContextMenuAt: () => false, onHoverAt: noop,
+  onWheelAt: (col, row, deltaY, deltaX) => { routed.push([col, row, deltaY, deltaX]); return consume },
+  getHyperlinkAt: () => undefined, onOpenHyperlink: noop, onMultiClick: noop,
+  onSelectionStart: noop, onSelectionDrag: noop, dispatchKeyboardEvent: noop,
+})
+app.internal_eventEmitter.on('input', event => {
+  if (event.key.wheelUp || event.key.wheelDown) fallback += 1
+})
+try {
+  app.processInput('\x1b[<65;5;6M'.repeat(3))
+  assert.deepEqual(routed, [[4, 5, 6, 0]])
+  assert.equal(fallback, 0, 'position routing consumes exactly one six-line notch')
+  now = 1074
+  app.processInput('\x1b[<65;5;6M')
+  assert.equal(routed.length, 1, 'same-direction report before the 75 ms boundary is coalesced')
+  now = 1075
+  app.processInput('\x1b[<65;5;6M')
+  now = 1076
+  app.processInput('\x1b[<64;5;6M'.repeat(2))
+  assert.deepEqual(routed.map(row => row[2]), [6, 6, -6])
+  consume = false
+  now = 1200
+  app.processInput('\x1b[<65;5;6M'.repeat(4))
+  assert.equal(fallback, 1, 'global fallback receives exactly one vertical notch')
+  app.processInput('\x1b[<67;5;6M'.repeat(2))
+  assert.deepEqual(routed.slice(-2).map(row => row.slice(2)), [[0, 3], [0, 3]],
+    'horizontal wheel keeps upstream three-column steps and independent reports')
+  console.log('wheel-notch: actual App routes six-line vertical notches; burst suppression and fallback pass')
+} finally {
+  if (originalNow) Object.defineProperty(performance, 'now', originalNow)
+  else Reflect.deleteProperty(performance, 'now')
+  app.querier.dispose()
+  if (app.incompleteEscapeTimer) clearTimeout(app.incompleteEscapeTimer)
+}
