+  /** Resolve the cross-process owner lease path for one session artifact. */
+  private leasePath(meta: SessionHeader): string | undefined {
+    const location = this.backend.locate?.(meta)
+    return location === undefined ? undefined : `${location.path}${DURABLE_LEASE_SUFFIX}`
+  }
+
+  /** Read the pid recorded in a lease file, or `undefined` when absent or invalid. */
+  private async leaseHolder(path: string): Promise<number | undefined> {
+    let text: string
+    try {
+      text = await readFile(path, 'utf8')
+    } catch {
+      return undefined
+    }
+    const pid = Number(text.trim())
+    return Number.isSafeInteger(pid) && pid > 0 ? pid : undefined
+  }
+
+  /**
+   * Ensure this process holds the artifact's owner lease. A live foreign
+   * holder refuses (another process owns the session); a stale holder is
+   * reclaimed atomically. Returns the lease path, or `undefined` when the
+   * backend names no per-session artifact (coordination degrades to the
+   * revision guard only).
+   */
+  private async holdLease(meta: SessionHeader): Promise<string | undefined> {
+    const path = this.leasePath(meta)
+    if (path === undefined) return undefined
+    for (;;) {
+      const holder = await this.leaseHolder(path)
+      if (holder === process.pid) return path
+      if (holder !== undefined && isProcessAlive(holder)) {
+        throw new Error(`session "${meta.id}" is live in another process (pid ${holder}); refusing to write its durable log`)
+      }
+      // A dead holder's lease must be removed BEFORE the exclusive create,
+      // otherwise open('wx') would retry against the same stale file forever.
+      if (holder !== undefined) await rm(path, { force: true })
+      try {
+        // A lazy session may not have materialized its directory yet.
+        await mkdir(dirname(path), { recursive: true })
+        const handle = await open(path, 'wx', 0o600)
+        try {
+          await handle.writeFile(`${process.pid}\n`)
+        } finally {
+          await handle.close()
+        }
+        return path
+      } catch (error) {
+        // A concurrent creator won the lease; re-read the holder and either
+        // adopt it (our pid: HMR/re-acquire) or refuse it (foreign live pid).
+        if (!isEEXIST(error)) throw error
+      }
+    }
+  }
+
+  /** Release a lease this process holds; a lease held by anyone else stays. */
+  private async releaseLease(path: string | undefined): Promise<void> {
+    if (path === undefined) return
+    try {
+      const text = (await readFile(path, 'utf8')).trim()
+      if (text === `${process.pid}`) await rm(path, { force: true })
+    } catch {
+      /* already gone */
+    }
+  }
+
+  /**
+   * Re-sync local state after a foreign durable write was observed. When the
+   * stored prefix still reproduces this live session's own log, the cursor
+   * advances so the pending batch appends only its unpublished suffix; a
+   * diverged stored log is a collision and refuses instead of writing
+   * overlapping seqs.
+   */
+  private async reconcileLiveState(id: SessionId, state: SessionState): Promise<void> {
+    const stored = await this.backend.loadStored(id)
+    if (stored === undefined) {
+      throw new Error(`session "${id}" durable log disappeared while a live session was attached`)
+    }
+    const storedEvents = snapshotStoredEvents(stored.events, id)
+    if (state.owner === undefined || !seedCoversPrefix(state.owner.events, storedEvents)) {
+      throw new Error(`session "${id}" durable log changed underneath this live session and no longer matches its event log (another process owns it); refusing stale append`)
+    }
+    state.cursor = storedEvents.length
+    state.revision = stored.revision
+  }
