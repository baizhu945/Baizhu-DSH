diff --git a/packages/client/ui-primitives/src/TerminalBlock.module.css b/packages/client/ui-primitives/src/TerminalBlock.module.css
index c4d4ddd..d2d7cc6 100644
--- a/packages/client/ui-primitives/src/TerminalBlock.module.css
+++ b/packages/client/ui-primitives/src/TerminalBlock.module.css
@@ -41,9 +41,9 @@
   padding: 9px 14px 9px var(--dsl-terminal-gutter);
   border-top-left-radius: var(--dsl-terminal-radius);
   border-top-right-radius: var(--dsl-terminal-radius);
-  /* A long multi-line command scrolls inside the banner (same cap as the
-     IN/OUT card's sections) instead of pushing the output off screen. */
+  /* Scroll long commands along either axis without hiding their content. */
   max-height: 150px;
+  overflow-x: auto;
   overflow-y: auto;
 }
 
@@ -65,12 +65,12 @@
   border-bottom: 0.5px solid var(--dsw-alias-border-l2);
 }
 
-/* One row per command line. The prompt column is the only element allowed to
-   shrink; the status pill and the copy control keep their intrinsic width. */
+/* Keep preformatted commands at their intrinsic width unless a host explicitly
+   opts into wrapped commands (for example, the job-list surface). */
 .prompt {
   display: flex;
   flex-direction: column;
-  min-width: 0;
+  min-width: var(--dsl-terminal-prompt-min-width, max-content);
   flex: 1;
   font: var(--dsl-terminal-font);
 }
@@ -110,36 +110,37 @@
   color: var(--dsw-alias-label-tertiary);
 }
 
-/* Default `pre`, not `nowrap`: the prompt row renders the command verbatim,
-   and `nowrap` would collapse the repeated spaces, tabs, and alignment of an
-   indented continuation. Hosts opt into wrapping long commands by rebinding
-   the variable to `pre-wrap`; the ellipsis then simply never engages, and
-   overflow-wrap is inert while white-space stays `pre`. */
+/* Preserve whitespace and the host's pre-wrap opt-in; the header now owns
+   horizontal overflow instead of clipping long single-line commands. */
 .command {
   min-width: 0;
   color: var(--dsw-alias-label-primary);
-  overflow: hidden;
-  text-overflow: ellipsis;
   white-space: var(--dsl-terminal-command-whitespace, pre);
   overflow-wrap: anywhere;
 }
 
-/* Capped to the prompt's line height (Pill's own 24px height would exceed a
-   smaller-font prompt row and stretch the banner). Sticky against the
-   banner's own scroll so the pill and the copy control stay in reach while a
-   long command scrolls underneath. */
-.status {
+/* Keep both controls together at the top-right while either axis scrolls. */
+.actions {
   flex: none;
   position: sticky;
   top: 0;
+  right: 0;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  height: var(--dsl-terminal-line-height);
+  background-color: var(--dsw-alias-markdown-code-block);
+}
+
+/* Capped to the prompt line height instead of the pill's intrinsic 24px. */
+.status {
+  flex: none;
   height: var(--dsl-terminal-line-height);
   color: var(--dsw-alias-state-error-primary);
 }
 
 .copyButton {
   flex: none;
-  position: sticky;
-  top: 0;
   /* Card surface, not transparent: the control is sticky over the banner's
      own scroll, so scrolled command text must not bleed through it. */
   background-color: var(--dsw-alias-markdown-code-block);
