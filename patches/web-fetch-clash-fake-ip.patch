+/** RFC 2544 range used by Clash/Mihomo fake-IP DNS under an explicit opt-in. */
+const CLASH_FAKE_IP_FIRST_OCTET = 198
+const CLASH_FAKE_IP_SECOND_OCTETS = new Set([18, 19])
+
+/** Whether an IPv4/IPv4-mapped address belongs to the local fake-IP range. */
+function isClashFakeIpAddress(input: string): boolean {
+  let parsed: ipaddr.IPv4 | ipaddr.IPv6
+  try {
+    parsed = ipaddr.parse(stripIpv6Brackets(input))
+  } catch {
+    return false
+  }
+  const ipv4 = parsed instanceof ipaddr.IPv4
+    ? parsed
+    : parsed.isIPv4MappedAddress() ? parsed.toIPv4Address() : undefined
+  if (ipv4 === undefined) return false
+  const octets = ipv4.toByteArray()
+  return octets[0] === CLASH_FAKE_IP_FIRST_OCTET && CLASH_FAKE_IP_SECOND_OCTETS.has(octets[1] as number)
+}
