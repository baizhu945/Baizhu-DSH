+/** Rows moved by one physical mouse-wheel notch in the fullscreen TUI. */
+export const WHEEL_NOTCH_LINES = 6;
+/** Terminals can send several SGR wheel reports for the same hardware notch. */
+export const WHEEL_NOTCH_WINDOW_MS = 75;
+
+export type WheelNotchState = {
+  at: number;
+  direction: -1 | 0 | 1;
+};
+
+/** Return one six-row intent per short same-direction wheel-report burst. */
+export function wheelNotchDelta(
+  state: WheelNotchState,
+  direction: -1 | 1,
+  now: number,
+): number {
+  const elapsed = now - state.at;
+  if (state.direction === direction && elapsed >= 0 && elapsed < WHEEL_NOTCH_WINDOW_MS) {
+    return 0;
+  }
+  state.at = now;
+  state.direction = direction;
+  return direction * WHEEL_NOTCH_LINES;
+}
